# FastBrowse operator config — copy to `.env` (gitignored) and fill in.
# With no vision endpoint configured, hunts still run: they fall back to
# first-result picks and the receipt reports SKIP. Nothing crashes.

# Primary vision ("Jasper" role): any OpenAI-compatible chat-completions
# endpoint serving a vision-capable model, e.g. Qwen2.5-VL on llama.cpp:
#   llama.cpp server:  llama-server -m Qwen2.5-VL-7B-*.gguf --port 8080
#FASTBROWSE_VISION_URL=http://127.0.0.1:8080/v1/chat/completions
#FASTBROWSE_VISION_MODEL=qwen2.5-vl-7b

# Fallback vision ("Groq" role): free tier, 1M tokens/day at time of writing.
FASTBROWSE_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
FASTBROWSE_FALLBACK_MODEL=llama-3.2-11b-vision-preview
#FASTBROWSE_GROQ_API_KEY=sk-your-key-here

# Third-choice local vision endpoint — used when the primary is down AND the
# cloud fallback has no vision-capable model. Defaults already point at the
# local NVIDIA NIM proxy on this Mac, so it works with no config at all.
# Override these for a different host.
#FASTBROWSE_LOCAL_URL=http://127.0.0.1:8790/v1/chat/completions
#FASTBROWSE_LOCAL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
#FASTBROWSE_LOCAL_API_KEY=
# Reasoning VL models spend most of the token budget on reasoning_content and
# return content:null when the cap is too low (reads as a false negative).
#FASTBROWSE_LOCAL_MAX_TOKENS=1200

# Where finished downloads get copied.
#FASTBROWSE_PICS_DIR=~/Downloads/pictures

# camofox walks through Cloudflare; vanilla chromium doesn't (rule 14).
#FASTBROWSE_ENGINE=camofox

# 1 = skip vision looks entirely.
#FASTBROWSE_NO_VISION=
